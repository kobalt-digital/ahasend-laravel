{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":semanticCommitsDisabled"
    ],
    "timezone": "Europe/Amsterdam",
    "schedule": ["before 7am on monday"],
    "labels": ["dependencies"],
    "rangeStrategy": "widen",
    "minimumReleaseAge": "3 days",
    "vulnerabilityAlerts": {
        "labels": ["security"],
        "schedule": ["at any time"],
        "minimumReleaseAge": null
    },
    "packageRules": [
        {
            "description": "Keep the supported Laravel and Symfony ranges wide, and bump them by hand.",
            "matchPackageNames": ["illuminate/**", "symfony/**", "php"],
            "enabled": false
        },
        {
            "description": "One pull request for the development tooling.",
            "matchDepTypes": ["require-dev"],
            "groupName": "dev dependencies",
            "rangeStrategy": "bump"
        },
        {
            "description": "One pull request for the GitHub Actions.",
            "matchManagers": ["github-actions"],
            "groupName": "github actions"
        }
    ]
}
