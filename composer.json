{
    "name": "kobalt-digital/ahasend-laravel",
    "description": "AhaSend mail transport, API client and webhook handling for Laravel",
    "keywords": [
        "ahasend",
        "laravel",
        "mail",
        "mailer",
        "transport",
        "email",
        "webhooks"
    ],
    "homepage": "https://github.com/kobalt-digital/ahasend-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Kobalt Digital",
            "homepage": "https://kobaltdigital.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/kobalt-digital/ahasend-laravel/issues",
        "source": "https://github.com/kobalt-digital/ahasend-laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/mailer": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "KobaltDigital\\AhaSend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KobaltDigital\\AhaSend\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:unit": "pest",
        "test:coverage": "pest --coverage --min=100",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "KobaltDigital\\AhaSend\\AhaSendServiceProvider"
            ],
            "aliases": {
                "AhaSend": "KobaltDigital\\AhaSend\\Facades\\AhaSend"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
